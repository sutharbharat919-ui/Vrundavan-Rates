<!DOCTYPE html>
<html lang="gu">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VOPL GOLD - Premium Edition</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+Gujarati:wght@400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
:root {
  --bg:#f7f2ee;
  --surface:rgba(255,253,252,.98);
  --soft:#f5ece5;
  --coffee:#b9967d;
  --dark:#765543;
  --heading:#49362d;
  --text:#554239;
  --muted:#8b776c;
  --border:#e2d3c9;
  --success:#647c65;
  --danger:#9a5c55;
  --gold-gradient:linear-gradient(135deg,#bf953f 0%,#fcf6ba 25%,#b38728 50%,#fbf5b7 75%,#aa771c 100%);
  --shadow:0 10px 30px rgba(73,54,45,.07);
}

[data-theme="dark"] {
  --bg:#121212;
  --surface:#1e1e1e;
  --soft:#2d2521;
  --coffee:#d4af37;
  --dark:#e5c158;
  --heading:#f3e9e2;
  --text:#e0d5cd;
  --muted:#a69286;
  --border:#3d3530;
  --shadow:0 10px 30px rgba(0,0,0,.5);
}

* {
  box-sizing:border-box;
  transition:background-color .3s,border-color .3s,color .3s;
}

html {
  scroll-behavior:smooth;
}

body {
  margin:0;
  padding-bottom:70px;
  min-height:100vh;
  background:var(--bg);
  color:var(--text);
  font-family:'Noto Serif Gujarati',serif;
}

.notification-bar {
  background:var(--gold-gradient);
  color:#000;
  padding:8px 10px;
  font-size:13px;
  font-weight:700;
  overflow:hidden;
  position:relative;
  box-shadow:0 2px 10px rgba(0,0,0,.1);
}

.marquee {
  display:inline-block;
  white-space:nowrap;
  animation:marquee 25s linear infinite;
  padding-left:100%;
}

@keyframes marquee {
  0% { transform:translate3d(0,0,0); }
  100% { transform:translate3d(-100%,0,0); }
}

header {
  padding:20px 15px 30px;
  text-align:center;
  background:linear-gradient(145deg,#eadbd0,#dcc5b5);
  border-bottom:2px solid var(--coffee);
  box-shadow:0 6px 25px rgba(73,54,45,.12);
  position:relative;
}

[data-theme="dark"] header {
  background:linear-gradient(145deg,#231b15,#120d0a);
}

.header-tools {
  position:absolute;
  top:15px;
  right:15px;
  display:flex;
  gap:10px;
}

.theme-toggle-btn {
  background:var(--surface);
  border:1px solid var(--border);
  color:var(--text);
  width:40px;
  height:40px;
  border-radius:50%;
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:18px;
  box-shadow:var(--shadow);
  padding:0;
  margin:0;
}

.logo-box {
  width:100%;
  max-width:360px;
  height:140px;
  margin:0 auto 10px;
  display:flex;
  align-items:center;
  justify-content:center;
}

.logo {
  width:100%;
  height:100%;
  object-fit:contain;
}

header h1 {
  margin:0;
  color:var(--heading);
  font-family:'Poppins',sans-serif;
  font-size:32px;
  font-weight:700;
  letter-spacing:1px;
}

header p {
  margin:8px 0 0;
  color:var(--dark);
  font-size:16px;
  font-weight:600;
}

.live-clock-box {
  display:inline-flex;
  align-items:center;
  gap:8px;
  margin-top:12px;
  padding:6px 16px;
  background:rgba(255,255,255,.2);
  border-radius:20px;
  font-family:'Poppins',sans-serif;
  font-size:14px;
  font-weight:600;
  color:var(--heading);
  border:1px solid rgba(255,255,255,.3);
}

.container {
  width:100%;
  max-width:720px;
  margin:auto;
  padding:20px 12px 40px;
}

.card {
  position:relative;
  margin-bottom:25px;
  padding:22px;
  overflow:hidden;
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:20px;
  box-shadow:var(--shadow);
}

.card::before {
  content:"";
  position:absolute;
  top:0;
  left:0;
  right:0;
  height:4px;
  background:var(--gold-gradient);
}

h2 {
  margin:0 0 18px;
  color:var(--heading);
  font-size:22px;
  font-weight:700;
  display:flex;
  align-items:center;
  gap:10px;
}

.section-title {
  margin:20px 0 10px;
  padding:10px 14px;
  color:var(--dark);
  background:var(--soft);
  border-left:4px solid var(--coffee);
  border-radius:4px 10px 10px 4px;
  font-size:14px;
  font-weight:700;
}

.rate {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  min-height:60px;
  margin-bottom:10px;
  padding:12px 16px;
  background:var(--bg);
  border:1px solid var(--border);
  border-radius:14px;
}

.rate-label {
  color:var(--text);
  font-size:15px;
  font-weight:600;
  display:flex;
  align-items:center;
  gap:8px;
}

.price {
  color:var(--dark);
  font-family:'Poppins',sans-serif;
  font-size:17px;
  font-weight:700;
  white-space:nowrap;
  background:var(--soft);
  padding:6px 12px;
  border-radius:8px;
}

.date-box {
  margin-top:20px;
  padding:14px;
  background:var(--soft);
  border-radius:12px;
  display:flex;
  justify-content:space-between;
  flex-wrap:wrap;
  gap:10px;
}

.date-line {
  color:var(--muted);
  font-size:13px;
  font-weight:600;
}

/* MARKET NOTICE */

.market-notice {
  margin-top:16px;
  padding:14px 15px;
  display:flex;
  align-items:flex-start;
  gap:10px;
  background:var(--soft);
  border:1px solid var(--coffee);
  border-left:4px solid var(--coffee);
  border-radius:12px;
  color:var(--text);
  font-size:13px;
  font-weight:600;
  line-height:1.7;
}

.market-notice i {
  margin-top:4px;
  flex-shrink:0;
  color:var(--dark);
  font-size:16px;
}

.market-notice strong {
  color:var(--heading);
}

.graph-wrapper {
  position:relative;
  width:100%;
  height:260px;
  margin-top:15px;
}

input,select {
  width:100%;
  margin-top:10px;
  padding:14px;
  outline:none;
  color:var(--heading);
  background:var(--bg);
  border:1px solid var(--border);
  border-radius:12px;
  font-family:'Noto Serif Gujarati',serif;
  font-size:15px;
}

button {
  width:100%;
  margin-top:15px;
  padding:14px;
  border:0;
  border-radius:12px;
  color:#fff;
  background:var(--dark);
  font-family:'Noto Serif Gujarati',serif;
  font-size:16px;
  font-weight:700;
  cursor:pointer;
}

button:disabled {
  opacity:.55;
  cursor:not-allowed;
}

.secondary { background:#a98b78; }
.save-button { background:var(--success); }
.logout-button { background:var(--danger); }

.total {
  margin-top:20px;
  padding:20px;
  text-align:center;
  color:var(--heading);
  background:var(--soft);
  border:2px dashed var(--coffee);
  border-radius:14px;
  font-size:22px;
  font-weight:700;
}

.admin-status {
  margin-bottom:14px;
  padding:10px;
  text-align:center;
  color:var(--dark);
  background:var(--soft);
  border-radius:10px;
  font-size:12px;
}

.message {
  min-height:22px;
  margin:15px 0;
  text-align:center;
  color:var(--dark);
  font-size:14px;
  font-weight:700;
}

.hidden {
  display:none !important;
}

.whatsapp-float {
  position:fixed;
  bottom:85px;
  right:20px;
  background:#25d366;
  color:white;
  border-radius:50%;
  width:55px;
  height:55px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:28px;
  box-shadow:0 4px 15px rgba(0,0,0,.2);
  z-index:99;
  text-decoration:none;
}

.bottom-nav {
  position:fixed;
  bottom:0;
  left:0;
  right:0;
  height:65px;
  background:var(--surface);
  border-top:1px solid var(--border);
  display:flex;
  justify-content:space-around;
  align-items:center;
  z-index:100;
}

.nav-item {
  display:flex;
  flex-direction:column;
  align-items:center;
  color:var(--muted);
  text-decoration:none;
  font-size:11px;
  font-weight:600;
}

.nav-item i {
  font-size:20px;
  margin-bottom:4px;
}

.nav-item.active {
  color:var(--coffee);
}

footer {
  padding:25px 15px 90px;
  text-align:center;
  color:var(--muted);
  font-size:13px;
  border-top:1px solid var(--border);
  background:var(--soft);
}

.footer-links {
  margin-bottom:15px;
}

.footer-links a {
  color:var(--text);
  text-decoration:none;
  margin:0 10px;
  font-weight:600;
}

@media(max-width:500px) {
  header h1 { font-size:24px; }
  .logo-box { height:110px; }
  .price { font-size:15px; }
  .card { padding:17px; }
}
</style>
</head>

<body>

<div class="notification-bar">
  <div class="marquee">
    ✨ સ્વાગત છે! વ્રુન્દાવન ઓર્નામેન્ટ્સ માં સોના ચાંદીના લાઈવ ભાવ અહીં જોઈ શકાશે. રોજના સચોટ અને તાજા અપડેટ માટે પેજ વિઝિટ